# Web3Forms public access key for the Contact Us form.
# This is a public form identifier (safe to expose in the frontend bundle),
# not a secret backend credential. Get yours at https://web3forms.com.
VITE_WEB3FORMS_ACCESS_KEY=8e5df262-f938-48b9-8d6f-cd299b1a60ef

